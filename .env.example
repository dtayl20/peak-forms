# ---------------------------------------------------------------------------
# Local development only. Copy to .dev.vars for `wrangler pages dev`.
# Never commit real values.
# ---------------------------------------------------------------------------

# Admin API — second layer behind Cloudflare Access
ADMIN_KEY=dev-admin-key

# Cloudflare Turnstile (leave empty to disable spam checks locally)
TURNSTILE_SECRET=

# Twilio Verify — SMS OTP for one-time forms (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Meta Conversions API forwarding (optional)
META_CAPI_TOKEN=
META_DATASET_ID=
META_CRM_DATASET_ID=
META_CRM_SECRET=
META_REQUIRE_VERIFIED=false
